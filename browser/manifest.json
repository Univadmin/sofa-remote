{
  "manifest_version": 3,
  "name": "Sofa Remote Tabs",
  "version": "0.2.0",
  "description": "Yerel Sofa Remote kumandasından tarayıcı sekmelerini yönetin.",
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120"
}
